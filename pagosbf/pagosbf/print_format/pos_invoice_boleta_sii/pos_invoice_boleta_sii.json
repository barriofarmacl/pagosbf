 "doctype": "Print Format",
 "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&amp;display=swap\"/><style>\n@page { size: 3in 7.5in; margin: 0; }\n.print-format, .print-format table, .print-format tr, .print-format td, .print-format div, .print-format p, .print-format span {\n\tfont-family: Inter, \"Segoe UI\", system-ui, -apple-system, \"Helvetica Neue\", Roboto, Arial, sans-serif;\n\tcolor: #111;\n\t-webkit-font-smoothing: antialiased;\n\t-moz-osx-font-smoothing: grayscale;\n\t-webkit-print-color-adjust: exact;\n\tprint-color-adjust: exact;\n}\n@media screen {\n\t.print-format {\n\t\twidth: 3in;\n\t\tmin-height: 7.5in;\n\t\tpadding: 0.05in 0.06in 0.06in;\n\t\tbox-sizing: border-box;\n\t\tmargin: 0 auto;\n\t\tbackground: #fff;\n\t}\n}\n.bf-ticket {\n\twidth: 100%;\n\tfont-size: 9px;\n\tline-height: 1.2;\n\tborder-top: 3px double #111;\n\tpadding-top: 5px;\n\tbox-sizing: border-box;\n}\n.bf-center { text-align: center; }\n.bf-brand {\n\tfont-size: 14px;\n\tfont-weight: 700;\n\tletter-spacing: 0.03em;\n\tmargin: 0 0 1px 0;\n\tline-height: 1.1;\n}\n.bf-sub {\n\tfont-size: 14px;\n\tfont-weight: 700;\n\ttext-transform: uppercase;\n\tletter-spacing: 0.14em;\n\tcolor: #333;\n\tmargin: 0 0 3px 0;\n\tline-height: 1.15;\n}\n.bf-muted { font-size: 9px; color: #444; }\n.bf-rule {\n\tborder: none;\n\tborder-top: 1px solid #222;\n\tmargin: 3px 0 4px;\n\theight: 0;\n}\n.bf-two {\n\twidth: 100%;\n\tborder-collapse: collapse;\n\tfont-size: 9px;\n\ttable-layout: fixed;\n}\n.bf-two td {\n\tpadding: 0 0 1px 0;\n\tvertical-align: top;\n\tline-height: 1.12;\n}\n.bf-two td:first-child {\n\twidth: 44%;\n\tmax-width: 1.15in;\n\tcolor: #333;\n\tpadding-right: 2px;\n}\n.bf-two td.r {\n\ttext-align: right;\n\twhite-space: nowrap;\n\tfont-variant-numeric: tabular-nums;\n\twidth: 56%;\n}\n.bf-items {\n\twidth: 100%;\n\tborder-collapse: collapse;\n\tfont-size: 8.5px;\n\tmargin: 0;\n\ttable-layout: fixed;\n}\n.print-format .bf-items thead th,\n.print-format .bf-items tbody td {\n\tline-height: 1.2 !important;\n\tvertical-align: top;\n}\n.bf-items th, .bf-items td {\n\tpadding: 0;\n\tborder-bottom: 1px solid #ddd;\n}\n.bf-items thead th {\n\tfont-weight: 700;\n\tfont-size: 9px;\n\ttext-transform: uppercase;\n\tletter-spacing: 0.05em;\n\tcolor: #333;\n\tborder-bottom: 1px solid #111;\n\tpadding: 0 0 1px 0;\n}\n.bf-items tbody td {\n\tpadding: 1px 0 0 0;\n\tfont-size: 8.5px;\n\tborder-bottom: 1px solid #ddd;\n}\n.bf-items tbody .bf-muted {\n\tfont-size: 7.5px;\n\tcolor: #444;\n}\n.bf-items tbody tr:last-child td {\n\tborder-bottom: none !important;\n\tpadding-bottom: 0;\n}\n.bf-items .r { text-align: right; font-variant-numeric: tabular-nums; }\n.bf-items td:first-child { padding-right: 2px; word-wrap: break-word; }\n.bf-tot {\n\twidth: 100%;\n\tborder-collapse: collapse;\n\tfont-size: 9px;\n\tmargin-top: 0;\n\tpadding-top: 3px;\n\tborder-top: 2px solid #000;\n\ttable-layout: fixed;\n}\n.bf-tot td {\n\tpadding: 0;\n\tline-height: 1 !important;\n}\n.bf-tot td:first-child { width: 58%; color: #333; }\n.bf-tot td.r {\n\ttext-align: right;\n\tfont-variant-numeric: tabular-nums;\n}\n.bf-strong { font-weight: 700; }\n.bf-alert {\n\tborder: 1px solid #333;\n\tpadding: 4px 5px;\n\tmargin: 4px 0;\n\tfont-size: 9px;\n\ttext-align: center;\n\tline-height: 1.15;\n}\n.bf-pdf {\n\ttext-align: center;\n\tmargin: 4px 0 2px;\n\twidth: 100%;\n\tbox-sizing: border-box;\n}\n.bf-pdf img {\n\twidth: 90%;\n\tmax-width: 90%;\n\theight: auto;\n\tdisplay: block;\n\tmargin: 0 auto;\n\timage-rendering: pixelated;\n}\n@media print {\n\t.print-format {\n\t\twidth: 3in;\n\t\tmax-width: 3in;\n\t\tpadding: 0.05in 0.06in 0.06in;\n\t\tbox-sizing: border-box;\n\t}\n\t.bf-pdf img {\n\t\twidth: 90%;\n\t\tmax-width: 90%;\n\t}\n}\n.bf-foot {\n\tfont-size: 9px;\n\ttext-align: center;\n\tmargin-top: 3px;\n\tline-height: 1.1;\n\tletter-spacing: 0.04em;\n\ttext-transform: uppercase;\n\tcolor: #333;\n}\n\n.bf-top { box-sizing: border-box; margin: 0 0 2px 0; }\n.bf-top .bf-brand { font-size: 14px; line-height: 1; margin: 0; padding: 0; word-spacing: 0.12em; }\n.bf-top .bf-sub { font-size: 14px; line-height: 1; margin: 0 0 1px 0; letter-spacing: 0.12em; word-spacing: 0.28em; }\n.bf-top .bf-rut, .bf-top .bf-giro {\n\tfont-size: 9px; line-height: 1.05; margin: 0; padding: 0; color: #333;\n}\n.bf-top .bf-giro { margin-bottom: 1px; word-spacing: 0.1em; }\n.bf-top .bf-rut { word-spacing: 0.14em; }\n.bf-top .bf-rule--tight { margin: 1px 0 2px; }\n.bf-top .bf-meta {\n\tdisplay: block;\n\twidth: 100%;\n\tmargin: 0 0 2px 0;\n\tpadding: 0;\n\ttext-align: left;\n\tbox-sizing: border-box;\n\tborder: none;\n\tbackground: transparent;\n}\n.print-format .bf-top .bf-line {\n\tfont-size: 9px;\n\tline-height: 1.05;\n\tmargin: 0;\n\tpadding: 0;\n\ttext-align: left;\n\tcolor: #111;\n\tfont-variant-numeric: tabular-nums;\n\tword-wrap: break-word;\n}\n.bf-top .bf-addr {\n\tfont-size: 9px;\n\tline-height: 1.06;\n\tmargin: 0 auto;\n\tpadding: 0 2px;\n\tmax-width: 2.55in;\n\tcolor: #333;\n}\n.bf-top .bf-alert { margin: 2px 0 0; padding: 2px 4px; font-size: 9px; line-height: 1.1; }\n.bf-resol {\n\tfont-size: 9px; text-align: center; margin: 1px 0 0; line-height: 1.1;\n\tcolor: #333; letter-spacing: 0.02em;\n}\n\n</style>\n\n{% if letter_head %}\n<div class=\"bf-letter\">{{ letter_head }}</div>\n{% endif %}\n\n{% set sii = pos_invoice_sii_print_block(doc) %}\n\n<div class=\"bf-ticket\">\n<div class=\"bf-top\">\n\t<div class=\"bf-center bf-brand\">{{ _(\"Farmacias\") }} {{ doc.company }}</div>\n\t<div class=\"bf-center bf-sub\">{{ _(\"Boleta Electronica\") }}</div>\n\t{% if sii and sii.sii_ready and sii.rut_emisor_fmt %}\n\t<div class=\"bf-center bf-rut\">RUT {{ sii.rut_emisor_fmt }}</div>\n\t{% endif %}\n\t{% set caddr = company_address_display(doc.company) %}\n\t{% if caddr %}\n\t<div class=\"bf-center bf-addr\">{{ caddr|safe }}</div>\n\t{% endif %}\n\t<div class=\"bf-center bf-giro\">{{ _(\"Giro\") }}: Farmacia y Perfumeria</div>\n\n\t<hr class=\"bf-rule bf-rule--tight\"/>\n\n\t<div class=\"bf-meta\">\n\t\t<div class=\"bf-line\"><b>{{ _(\"Fecha\") }}:</b> {{ doc.get_formatted(\"posting_date\") }}</div>\n\t\t<div class=\"bf-line\"><b>{{ _(\"Hora\") }}:</b> {% if doc.posting_time %}{{ doc.get_formatted(\"posting_time\") }}{% else %}&mdash;{% endif %}</div>\n\t\t<div class=\"bf-line\"><b>{{ _(\"Cajero\") }}:</b> {{ doc.owner }}</div>\n\t\t<div class=\"bf-line\"><b>{{ _(\"Cliente\") }}:</b> {{ doc.customer_name }}</div>\n\t\t<div class=\"bf-line\"><b>{{ _(\"Recibo POS\") }}:</b> {{ doc.name }}</div>\n\t\t{% if sii and sii.sii_ready %}\n\t\t<div class=\"bf-line\"><b>{{ _(\"Tipo DTE\") }}:</b> {{ sii.tipo_dte or \"-\" }}</div>\n\t\t<div class=\"bf-line\"><b>{{ _(\"Folio\") }}:</b> {{ sii.folio or \"-\" }}</div>\n\t\t{% endif %}\n\t</div>\n\n\t{% if sii and sii.sii_sin_dte %}\n\t<div class=\"bf-alert\"><b>{{ _(\"Sin emision SII\") }}</b><br/>{{ sii.mensaje_print or _(\"Sin DTE Boleta vinculada. Emita y reimprima.\") }}</div>\n\t{% elif sii and not sii.sii_ready and not sii.sii_sin_dte %}\n\t<div class=\"bf-alert\">{{ _(\"Estado SII no disponible para este formato.\") }}</div>\n\t{% endif %}\n</div>\n\n\t<hr class=\"bf-rule\"/>\n\n\t<table class=\"bf-items\">\n\t\t<thead>\n\t\t\t<tr>\n\t\t\t\t<th>{{ _(\"Articulo\") }}</th>\n\t\t\t\t<th class=\"r\">{{ _(\"Cant / precio unitario\") }}</th>\n\t\t\t\t<th class=\"r\">{{ _(\"Valor\") }}</th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody>\n\t\t{% for item in doc.items %}\n\t\t\t<tr>\n\t\t\t\t<td>\n\t\t\t\t\t{% if item.item_code %}<span class=\"bf-muted\">{{ item.item_code }}</span><br/>{% endif %}\n\t\t\t\t\t{{ item.item_name or item.item_code }}\n\t\t\t\t</td>\n\t\t\t\t<td class=\"r\">{{ item.qty }} x {{ item.get_formatted(\"rate\") }}</td>\n\t\t\t\t<td class=\"r\">{{ item.get_formatted(\"amount\") }}</td>\n\t\t\t</tr>\n\t\t{% endfor %}\n\t\t</tbody>\n\t</table>\n\n\t<table class=\"bf-tot\">\n\t\t{% if doc.flags.show_inclusive_tax_in_print %}\n\t\t<tr><td>{{ _(\"Neto\") }}</td><td class=\"r\">{{ doc.get_formatted(\"net_total\", doc) }}</td></tr>\n\t\t{% else %}\n\t\t<tr><td>{{ _(\"Neto / afecto\") }}</td><td class=\"r\">{{ doc.get_formatted(\"net_total\", doc) }}</td></tr>\n\t\t{% endif %}\n\t\t{% for tax_line in pos_boleta_tax_lines(doc) %}\n\t\t\t<tr><td>{{ tax_line.label }}</td><td class=\"r\">{{ tax_line.formatted }}</td></tr>\n\t\t{% endfor %}\n\t\t{% if doc.discount_amount %}\n\t\t<tr><td>{{ _(\"Descuento\") }}</td><td class=\"r\">{{ doc.get_formatted(\"discount_amount\") }}</td></tr>\n\t\t{% endif %}\n\t\t<tr><td class=\"bf-strong\">{{ _(\"Monto total\") }}</td><td class=\"r bf-strong\">{{ doc.get_formatted(\"grand_total\") }}</td></tr>\n\t\t{% if doc.rounded_total %}\n\t\t<tr><td>{{ _(\"Total redondeado\") }}</td><td class=\"r\">{{ doc.get_formatted(\"rounded_total\") }}</td></tr>\n\t\t{% endif %}\n\t\t{% if doc.payments %}\n\t\t\t{% for pay in doc.payments %}\n\t\t\t<tr><td>{{ _(\"Pago\") }} ({{ pay.mode_of_payment or \"-\" }})</td><td class=\"r\">{{ pay.get_formatted(\"amount\", doc) }}</td></tr>\n\t\t\t{% endfor %}\n\t\t{% endif %}\n\t\t<tr><td class=\"bf-strong\">{{ _(\"Pagado\") }}</td><td class=\"r bf-strong\">{{ doc.get_formatted(\"paid_amount\") }}</td></tr>\n\t\t{% if doc.change_amount %}\n\t\t<tr><td>{{ _(\"Vuelto\") }}</td><td class=\"r\">{{ doc.get_formatted(\"change_amount\") }}</td></tr>\n\t\t{% endif %}\n\t</table>\n\n\t{% if sii and sii.sii_ready %}\n\t\t{% if sii.timbre_pdf417_data_url %}\n\t\t<div class=\"bf-pdf\"><img src=\"{{ sii.timbre_pdf417_data_url }}\" alt=\"PDF417\" /></div>\n\t\t<div class=\"bf-foot\">{{ _(\"Timbre Electronico SII\") }}</div>\n\t\t<div class=\"bf-resol\">Res 80 del 2014</div>\n\t\t{% elif sii.tiene_timbre %}\n\t\t<p class=\"bf-center bf-muted\">{{ _(\"Timbre disponible sin imagen PNG; consulte estado SII y reimprima.\") }}</p>\n\t\t<div class=\"bf-resol\">Res 80 del 2014</div>\n\t\t{% endif %}\n\t{% endif %}\n\n\t{% if doc.terms %}\n\t<hr class=\"bf-rule\"/>\n\t<p class=\"bf-muted\">{{ doc.terms }}</p>\n\t{% endif %}\n\t<p class=\"bf-center bf-muted\" style=\"margin-top:8px;\">{{ _(\"Gracias por su compra.\") }}</p>\n</div>\n",
