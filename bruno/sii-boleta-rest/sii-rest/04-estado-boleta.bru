meta {
  name: GET estado boleta folio
  type: http
  seq: 4
}

get {
  url: {{sii_api}}/boleta.electronica/{{rut_emisor_num}}-{{dv_emisor}}-{{tipo_dte}}-{{folio}}/estado
}

params:query {
  rut_receptor: {{rut_receptor_num}}
  dv_receptor: {{dv_receptor}}
  monto: {{monto}}
  fechaEmision: {{fecha_emision}}
}

headers {
  Accept: application/json
  User-Agent: {{user_agent}}
  Cookie: TOKEN={{token}}
}

docs {
  Documento 39 folio 20009. Receptor POS default 66666666-6, monto 1100, fecha 18-08-2026.
  Query params opcionales; si el SII pide coincidencia, dejarlos.
}
